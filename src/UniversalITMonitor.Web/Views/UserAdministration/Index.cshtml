@model UserAdministrationIndexViewModel
@using UniversalITMonitor.Core.Models
@{
    ViewData["Title"] = "User management";
}

<div class="page-heading">
    <div><div class="eyebrow">ADMINISTRATION</div><h1>User management</h1><p class="page-subtitle">Manage local accounts and access roles.</p></div>
    <a class="app-primary-link" asp-action="Create">Add user <span aria-hidden="true">+</span></a>
</div>

@if (TempData["Success"] is string success) { <div class="notice notice-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="notice notice-error" role="alert">@error</div> }

<section class="panel-card">
    <div class="panel-heading"><div><h2>Local accounts</h2><p>Passwords are stored as one-way password hashes.</p></div><span class="record-count">@Model.Users.Count user(s)</span></div>
    <div class="table-responsive">
        <table class="device-table" aria-label="Local users">
            <thead><tr><th>User</th><th>Username</th><th>Role</th><th>State</th><th>Created (UTC)</th><th></th></tr></thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="device-name-link">@user.DisplayName</td>
                    <td>@user.UserName</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td><span class="device-status @(user.IsEnabled ? "status-up" : "status-unknown")"><span class="status-dot"></span>@(user.IsEnabled ? "Enabled" : "Disabled")</span></td>
                    <td>@user.CreatedUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="row-actions"><a asp-action="Edit" asp-route-id="@user.Id">Edit</a><a asp-action="Delete" asp-route-id="@user.Id">Delete</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
