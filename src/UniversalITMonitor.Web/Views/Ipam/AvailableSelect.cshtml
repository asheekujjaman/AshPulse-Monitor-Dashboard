@model IReadOnlyList<UniversalITMonitor.Core.Models.IpamSubnet>
@{ ViewData["Title"] = "Available IPs"; }
<div class="page-heading"><div><div class="eyebrow">ADDRESS INVENTORY</div><h1>Available IP Finder</h1><p class="page-subtitle">Choose a subnet to find addresses not currently assigned, reserved, conflicted, or unknown.</p></div></div>
<nav class="ipam-internal-nav" aria-label="IPAM navigation"><a asp-action="Index">Overview</a><a asp-action="Explore">IP Explorer</a><a class="active" asp-action="Available">Available IPs</a><a asp-action="Reservations">Reservations</a><a asp-action="Subnets">Subnet management</a><a asp-action="History">IP history</a></nav>
<section class="panel-card"><div class="panel-heading"><div><h2>Choose a subnet</h2></div></div>
@if (Model.Count == 0) { <div class="empty-state"><h3>No subnet registered</h3><a class="app-primary-link" asp-action="CreateSubnet">Register subnet</a></div> }
else { <div class="ipam-subnet-picker">@foreach (var subnet in Model) { <a class="ipam-subnet-choice" asp-action="Available" asp-route-id="@subnet.Id"><strong>@subnet.Cidr</strong><span>@subnet.Location</span><b>Find available addresses →</b></a> }</div> }
</section>
