@{
    ViewData["Title"] = "Access denied";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-kicker"><span class="status-dot status-warning"></span>Permission required</div>
        <h1>Access denied</h1>
        <p class="auth-description">Your account does not have permission to open this page.</p>
        <a class="btn btn-primary app-primary-button w-100" asp-controller="Home" asp-action="Index">Return to overview</a>
    </div>
</section>
