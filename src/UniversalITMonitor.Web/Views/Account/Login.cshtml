@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <img src="~/images/brand/logo-horizontal-light.svg" alt="AshPulse Infrastructure Monitor. Monitor Everything. Miss Nothing." width="320" height="61" />
        </div>
        <div class="auth-kicker"><span class="context-dot"></span>Secure infrastructure access</div>
        <h1>Welcome back</h1>
        <p class="auth-description">Sign in to your on-premises monitoring workspace.</p>

        <form asp-controller="Account" asp-action="Login" method="post" class="auth-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-field">
                <label asp-for="UserName">Username</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UserName" class="field-validation"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>
            <label class="remember-option">
                <input asp-for="RememberMe" />
                <span>Keep me signed in on this device</span>
            </label>
            <button type="submit" class="btn btn-primary app-primary-button w-100">Sign in</button>
        </form>

        <div class="auth-note">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 1 1 8 0v3M12 14v2"></path></svg>
            <span>Accounts and monitoring data are stored locally.</span>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
